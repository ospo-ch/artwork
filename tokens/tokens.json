{
  "$description": "ospo.ch brand design tokens (W3C DTCG format). Source of truth for the palette; run `node tokens/build.mjs` to compile outputs.",
  "color": {
    "$type": "color",
    "red": {
      "100": { "$value": "#FFE3E4", "$description": "Subtle background wash" },
      "300": { "$value": "#FF6A72", "$description": "Tint / accent on dark" },
      "500": { "$value": "#F2000C", "$description": "Primary brand. CMYK 0/100/95/5. Large text & UI only on white (4.4:1 — not AA for body text)" },
      "700": { "$value": "#B80009", "$description": "Accessible red for body text / links on white (6.9:1)" },
      "900": { "$value": "#73000A", "$description": "Deep red for active / pressed states" }
    },
    "grey": {
      "100": { "$value": "#F5F5F5", "$description": "Subtle background" },
      "300": { "$value": "#D4D4D4", "$description": "Borders / dividers" },
      "500": { "$value": "#737373", "$description": "Lightest grey passing AA body text on white (4.7:1)" },
      "700": { "$value": "#404040", "$description": "Secondary text" },
      "900": { "$value": "#171717", "$description": "Primary text / ink" }
    },
    "black": { "$value": "#000000", "$description": "Mono mark, maximum contrast" },
    "white": { "$value": "#FFFFFF", "$description": "Surfaces, reversed mark" },

    "brand": { "$value": "{color.red.500}", "$description": "Primary brand colour" },
    "text": { "$value": "{color.grey.900}", "$description": "Primary text / ink" },
    "text-secondary": { "$value": "{color.grey.700}", "$description": "Secondary text" },
    "text-link": { "$value": "{color.red.700}", "$description": "Links / red text on white (AA)" },
    "surface": { "$value": "{color.white}", "$description": "Default background" },
    "surface-muted": { "$value": "{color.grey.100}", "$description": "Muted background" },
    "border": { "$value": "{color.grey.300}", "$description": "Borders / dividers" }
  }
}
